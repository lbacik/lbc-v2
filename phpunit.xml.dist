<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
         convertDeprecationsToExceptions="false"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="SYMFONY_PHPUNIT_REMOVE" value="" />
        <server name="SYMFONY_PHPUNIT_VERSION" value="9.6" />
        <!-- Deployment-owned SES tenant boundary (test values, never secrets). -->
        <server name="SES_TENANT_NAME" value="test-tenant" />
        <server name="SES_CONFIGURATION_SET" value="lbc-first-contact-events" />
        <server name="SES_REGION" value="eu-central-1" />
        <server name="MAIL_FROM_ADDRESS" value="no-reply@lukaszbacik.com" />
        <server name="MAIL_OPERATOR_RECIPIENT" value="operator@example.test" />
        <server name="SES_ACCESS_KEY_ID" value="test-key" />
        <server name="SES_SECRET_ACCESS_KEY" value="test-secret" />
        <server name="MAIL_MODE" value="enabled" />
        <server name="MAIL_VALIDATION_UNTIL" value="" />
        <server name="MAIL_VALIDATION_TOKEN" value="" />
        <server name="CONTACT_RATE_LIMIT" value="100" />
        <server name="CONTACT_RATE_WINDOW_SECONDS" value="3600" />
        <server name="RECAPTCHA_EXPECTED_HOSTNAME" value="" />
        <server name="RECAPTCHA_SCORE_THRESHOLD" value="0.5" />
        <server name="GOOGLE_RECAPTCHA_SECRET" value="test-secret" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </coverage>

    <listeners>
        <listener class="Symfony\Bridge\PhpUnit\SymfonyTestsListener" />
    </listeners>

    <extensions>
    </extensions>
</phpunit>
