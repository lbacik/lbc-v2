{# Prototype Switcher - Floating bar for comparing UI variations of HireTheAgent promotion #}
<div id="prototype-switcher" style="
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 99999;
    background: rgba(17, 24, 39, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(75, 85, 99, 0.5);
    border-radius: 9999px;
    box-shadow: 0 16px 36px -4px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08);
    padding: 6px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: #f3f4f6;
    font-size: 13px;
    user-select: none;
">
    <div style="display: flex; align-items: center; gap: 6px; padding-right: 8px; border-right: 1px solid rgba(75, 85, 99, 0.6); font-weight: 600; color: #9ca3af; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">
        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #3b82f6; box-shadow: 0 0 8px #3b82f6;"></span>
        Prototype
    </div>

    <!-- Prev button -->
    <button id="proto-prev" type="button" title="Previous variant (Left arrow)" style="
        background: rgba(255, 255, 255, 0.08);
        border: none;
        color: #e5e7eb;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s;
    " onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.08)'">
        <i class="bi bi-chevron-left" style="font-size: 12px;"></i>
    </button>

    <!-- Variant buttons -->
    <div style="display: flex; gap: 4px; align-items: center;">
        <button type="button" class="proto-btn" data-variant="A" style="
            background: {{ variant == 'A' ? '#2563eb' : 'transparent' }};
            color: {{ variant == 'A' ? '#ffffff' : '#9ca3af' }};
            border: none;
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: {{ variant == 'A' ? '600' : '400' }};
            cursor: pointer;
            transition: all 0.15s;
        ">
            A: Hero Pill & Card
        </button>

        <button type="button" class="proto-btn" data-variant="B" style="
            background: {{ variant == 'B' ? '#2563eb' : 'transparent' }};
            color: {{ variant == 'B' ? '#ffffff' : '#9ca3af' }};
            border: none;
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: {{ variant == 'B' ? '600' : '400' }};
            cursor: pointer;
            transition: all 0.15s;
        ">
            B: Showcase Section
        </button>

        <button type="button" class="proto-btn" data-variant="C" style="
            background: {{ variant == 'C' ? '#2563eb' : 'transparent' }};
            color: {{ variant == 'C' ? '#ffffff' : '#9ca3af' }};
            border: none;
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: {{ variant == 'C' ? '600' : '400' }};
            cursor: pointer;
            transition: all 0.15s;
        ">
            C: Live Terminal
        </button>

        <button type="button" class="proto-btn" data-variant="D" style="
            background: {{ variant == 'D' ? '#2563eb' : 'transparent' }};
            color: {{ variant == 'D' ? '#ffffff' : '#9ca3af' }};
            border: none;
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: {{ variant == 'D' ? '600' : '400' }};
            cursor: pointer;
            transition: all 0.15s;
        ">
            D: Sticky Header (A+C)
        </button>

        <button type="button" class="proto-btn" data-variant="baseline" style="
            background: {{ variant == 'baseline' ? '#374151' : 'transparent' }};
            color: {{ variant == 'baseline' ? '#ffffff' : '#6b7280' }};
            border: none;
            padding: 4px 8px;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 400;
            cursor: pointer;
            transition: all 0.15s;
        ">
            Baseline
        </button>
    </div>

    <!-- Next button -->
    <button id="proto-next" type="button" title="Next variant (Right arrow)" style="
        background: rgba(255, 255, 255, 0.08);
        border: none;
        color: #e5e7eb;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s;
    " onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.08)'">
        <i class="bi bi-chevron-right" style="font-size: 12px;"></i>
    </button>

    <div style="font-size: 10px; color: #6b7280; padding-left: 4px; border-left: 1px solid rgba(75, 85, 99, 0.6);">
        Keys: <kbd style="background: rgba(255,255,255,0.1); padding: 1px 4px; border-radius: 3px; font-family: monospace;">&larr;</kbd> <kbd style="background: rgba(255,255,255,0.1); padding: 1px 4px; border-radius: 3px; font-family: monospace;">&rarr;</kbd>
    </div>
</div>

<script>
(() => {
    const variants = ['A', 'B', 'C', 'D', 'baseline'];
    const current = '{{ variant }}';

    function setVariant(v) {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', v);
        window.location.href = url.toString();
    }

    document.querySelectorAll('.proto-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const v = btn.getAttribute('data-variant');
            if (v && v !== current) {
                setVariant(v);
            }
        });
    });

    const currentIndex = Math.max(0, variants.indexOf(current));

    document.getElementById('proto-prev')?.addEventListener('click', () => {
        const prevIndex = (currentIndex - 1 + variants.length) % variants.length;
        setVariant(variants[prevIndex]);
    });

    document.getElementById('proto-next')?.addEventListener('click', () => {
        const nextIndex = (currentIndex + 1) % variants.length;
        setVariant(variants[nextIndex]);
    });

    window.addEventListener('keydown', (e) => {
        const active = document.activeElement;
        if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.isContentEditable)) {
            return;
        }
        if (e.key === 'ArrowLeft') {
            e.preventDefault();
            const prevIndex = (currentIndex - 1 + variants.length) % variants.length;
            setVariant(variants[prevIndex]);
        } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            const nextIndex = (currentIndex + 1) % variants.length;
            setVariant(variants[nextIndex]);
        }
    });
})();
</script>
