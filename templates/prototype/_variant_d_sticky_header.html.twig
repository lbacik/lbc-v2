</div>

<script>
(() => {
    const banner = document.getElementById('sticky-agent-banner');
    const closeBtn = document.getElementById('sticky-banner-close');
    const reopenBtn = document.getElementById('sticky-banner-reopen');
    const logToggle = document.getElementById('sticky-log-toggle');
    const terminalDrawer = document.getElementById('sticky-terminal-drawer');
    const logChevron = document.getElementById('sticky-log-chevron');

    function updateBodyOffset() {
        if (banner && banner.style.display !== 'none') {
            const h = banner.offsetHeight;
            document.body.style.paddingTop = h + 'px';
            const headerNav = document.getElementById('header');
            if (headerNav) {
                headerNav.style.top = h + 'px';
            }
        } else {
            document.body.style.paddingTop = '0px';
            const headerNav = document.getElementById('header');
            if (headerNav) {
                headerNav.style.top = '0px';
            }
        }
    }

    // Initial offset calculation
    updateBodyOffset();
    window.addEventListener('resize', updateBodyOffset);

    // Toggle dropdown terminal drawer
    logToggle?.addEventListener('click', () => {
        if (!terminalDrawer) return;
        const isHidden = terminalDrawer.style.display === 'none' || terminalDrawer.style.display === '';
        terminalDrawer.style.display = isHidden ? 'block' : 'none';
        if (logChevron) {
            logChevron.className = isHidden ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
        }
        updateBodyOffset();
    });

    // Close banner
    closeBtn?.addEventListener('click', () => {
        if (banner) {
            banner.style.display = 'none';
        }
        if (reopenBtn) {
            reopenBtn.style.display = 'inline-flex';
        }
        updateBodyOffset();
    });

    // Reopen banner
    reopenBtn?.addEventListener('click', () => {
        if (banner) {
            banner.style.display = 'block';
        }
        if (reopenBtn) {
            reopenBtn.style.display = 'none';
        }
        updateBodyOffset();
    });
})();
</script>
