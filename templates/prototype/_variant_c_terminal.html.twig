<script>
(() => {
    const termWidget = document.getElementById('agent-terminal-widget');
    const termPill = document.getElementById('term-minimized-pill');
    const toggleBtn = document.getElementById('term-toggle-btn');
    const closeBtn = document.getElementById('term-close');

    function minimize() {
        if (termWidget && termPill) {
            termWidget.style.display = 'none';
            termPill.style.display = 'inline-flex';
        }
    }

    function expand() {
        if (termWidget && termPill) {
            termWidget.style.display = 'block';
            termPill.style.display = 'none';
        }
    }

    closeBtn?.addEventListener('click', minimize);
    toggleBtn?.addEventListener('click', minimize);
    termPill?.addEventListener('click', expand);
})();
</script>
